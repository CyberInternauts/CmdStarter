    <ProjectReference Include="..\samples\CmdStarter.Samples.HelloWorld\CmdStarter.Samples.HelloWorld.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\samples\CmdStarter.Samples.TwoCommands\CmdStarter.Samples.TwoCommands.csproj" ReferenceOutputAssembly="false" />
