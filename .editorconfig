dotnet_diagnostic.CA1707.severity = none
# Lot 004 : à revoir avec la nouvelle API publique — renommer les paramètres génériques publics casserait la compatibilité source.
dotnet_diagnostic.CA1715.severity = none
# Lot 004 : à revoir avec la nouvelle API publique — modifier les namespaces publics casserait la compatibilité des consommateurs.
dotnet_diagnostic.CA1716.severity = none
# Lot 004 : à revoir avec la nouvelle API publique — rendre VisitCommands statique changerait sa signature publique.
