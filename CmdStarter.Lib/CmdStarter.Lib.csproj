<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\ProjectsCommon.props" />
	<Import Project="..\Packaging.props" />

  <PropertyGroup>
    <RootNamespace>CyberInternauts.CmdStarter</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <PackageId>$(BasePackageName).CmdStarter</PackageId>
    <Title>CmdStarter</Title>
    <Description>Turns plain C# classes and methods into a System.CommandLine command tree, with Microsoft dependency injection, a REPL and command states.</Description>
    <PackageTags>System.CommandLine;command line;cli;commands;dependency injection;repl</PackageTags>
    <PackageReadmeFile>PKG-README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0-preview.1: rewrite on System.CommandLine 2.0 stable and .NET 10, with breaking changes. Migration guide: https://github.com/CyberInternauts/CmdStarter/blob/master/docs/migration/1.x-to-2.0.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CmdStarter.Analyzers\CmdStarter.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\CmdStarter.Analyzers\bin\$(Configuration)\netstandard2.0\CmdStarter.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\PKG-README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

</Project>
