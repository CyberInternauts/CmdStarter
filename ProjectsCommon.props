<Project>

	<PropertyGroup>
		<Version>2.0.0-preview.1</Version>
		<BasePackageName>cints</BasePackageName>
		<BaseNamespace>CyberInternauts</BaseNamespace>
		<Company>CyberInternauts</Company>
		<Authors>Jonathan Boivin, Norbert Ormándi</Authors>
		<Owners>djon2003, DeszkaCodes</Owners>
		<Copyright>$(Company)</Copyright>
		<RepositoryUrl>https://github.com/CyberInternauts/CmdStarter</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<RootNamespace>$(BaseNamespace).$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	</PropertyGroup>

</Project>
