<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\ProjectsCommon.props" />

  <PropertyGroup>
    <RootNamespace>CyberInternauts.CmdStarter.Hosting</RootNamespace>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>$(BasePackageName).CmdStarter.Hosting</PackageId>
    <Description>Generic Host (Microsoft.Extensions.Hosting) integration for CmdStarter.</Description>
    <PackageOutputPath>..\artefacts</PackageOutputPath>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CmdStarter.Lib\CmdStarter.Lib.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>
</Project>
